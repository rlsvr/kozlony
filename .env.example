# Local development configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5433/messageboard?sslmode=disable
NATS_URL=nats://localhost:4222
LOG_LEVEL=debug
PRETTY_LOGGING=true

# Micro-batch drainer & concurrency tuning
NATS_CONCURRENT_SUBSCRIBERS=8
NATS_COUNTER_CONSUMER_NAME=board-counters
DRAIN_BATCH_SIZE=2000
DRAIN_FLUSH_INTERVAL=100ms
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=10
